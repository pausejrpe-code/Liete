{
  "name": "liete-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm tokens:build && pnpm --filter @liete/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "storybook": "pnpm --filter @liete/tokens build && pnpm --filter @liete/ui-web storybook",
    "build-storybook": "pnpm --filter @liete/tokens build && pnpm --filter @liete/ui-web build-storybook",
    "tokens:build": "pnpm --filter @liete/tokens build"
  }
}

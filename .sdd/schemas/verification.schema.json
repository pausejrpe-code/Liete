{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SDD Verification Schema",
  "type": "object",
  "required": ["featureId", "totalRequirements", "passedRequirements", "specCompliancePct", "status"],
  "properties": {
    "featureId": { "type": "string" },
    "totalRequirements": { "type": "integer", "minimum": 0 },
    "passedRequirements": { "type": "integer", "minimum": 0 },
    "failedRequirements": { "type": "integer", "minimum": 0 },
    "specCompliancePct": { "type": "number", "minimum": 0, "maximum": 100 },
    "regressionPassed": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["COMPLETE", "NOT COMPLETE"]
    }
  }
}
